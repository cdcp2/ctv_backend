  "query": "\n         SELECT \n            id, \n            title, \n            slug, \n            content, \n            excerpt, \n            main_image_url, \n            video_embed_url,\n            author_id, \n            category_id, \n            status as \"status!: String\", \n            is_featured as \"is_featured!: bool\", \n            is_breaking as \"is_breaking!: bool\", \n            views_count as \"views_count!: i64\",\n             published_at, created_at, updated_at \n         FROM articles \n         WHERE slug = $1\n        ",
