{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.name, t.slug\n        FROM tags t\n        JOIN article_tags at ON at.tag_id = t.id\n        JOIN articles a ON a.id = at.article_id\n        WHERE a.slug = $1\n        ORDER BY t.name ASC\n        ",
