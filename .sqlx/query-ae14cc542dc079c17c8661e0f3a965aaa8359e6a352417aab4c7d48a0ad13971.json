  "query": "\n        INSERT INTO live_stream_config (id, stream_key, updated_at)\n        VALUES (1, $1, NOW())\n        ON CONFLICT (id) DO UPDATE SET\n            stream_key = EXCLUDED.stream_key,\n            updated_at = NOW()\n        RETURNING id, ingest_url, stream_key, playback_url, is_active as \"is_active!: bool\", notes, updated_at\n        ",
